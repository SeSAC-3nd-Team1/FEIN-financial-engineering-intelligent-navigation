{
  "name": "SeSAC Data Dev",
  "dockerComposeFile": "../../compose.yaml",
  "service": "data",
  "workspaceFolder": "/app",
  "runServices": [
    "frontend",
    "backend",
    "postgres",
    "redis",
    "data"
  ],
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
