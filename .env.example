# ============================================================
# SeSAC 3차 프로젝트 로컬 개발 환경변수 예시
# 실제 Secret 값은 .env에만 작성하고 GitHub에 커밋하지 않습니다.
# ============================================================

# ------------------------------------------------------------
# 로컬 서비스 포트
# Docker Compose에서 각 서비스를 호스트 PC에 노출할 포트입니다.
# 다른 프로그램과 포트가 겹칠 때만 변경합니다.
# ------------------------------------------------------------

# React + Vite Frontend 접속 포트
FRONTEND_PORT=5173

# FastAPI Backend 접속 포트
BACKEND_PORT=8000

# Redis 호스트 접속 포트
REDIS_PORT=6379


# ------------------------------------------------------------
# Frontend 개발용 Mock 설정
# 실제 백테스트 모델/KRX 데이터 연동이 끝나기 전까지, Strategy Detail의 백테스트 UX를
# 화면에서 확인하기 위한 개발용 스위치입니다. true일 때만 Mock 데이터를 쓰고, 그 외에는
# (빈 값 포함) 항상 실제 Backend Backtest API를 호출합니다. 운영 환경 기본값은 false/미설정입니다.
# ------------------------------------------------------------

# true로 설정하면 Strategy Detail의 백테스트가 실제 API 대신 프론트 Mock 데이터를 사용합니다.
# docker compose로 실행할 때만 반영되고(compose.yaml frontend.environment 참고),
# 컨테이너 없이 frontend에서 직접 `npm run dev`를 쓴다면 frontend/.env.local에 따로 설정하세요.
VITE_USE_MOCK_BACKTEST=false


# ------------------------------------------------------------
# Azure Database for PostgreSQL Flexible Server
# 일반 개발과 시연은 팀 공용 Azure PostgreSQL 1개만 사용합니다.
# DATABASE_URL은 필수이며 미설정/빈 값이면 Docker Compose가 실행을 중단합니다.
# 실제 사용자명·비밀번호·호스트는 .env에만 작성하고 커밋하지 않습니다.
# ------------------------------------------------------------

# Backend / migration / Data / AI가 모두 동일한 PostgreSQL을 사용합니다.
# 예: postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>?sslmode=require
# 비밀번호에 @, :, /, %, #, ? 등이 있으면 URL percent-encoding이 필요합니다.
DATABASE_URL=

# DB가 시작 중이거나 Azure 연결이 일시적으로 지연될 때 db-init 재시도 정책
DB_INIT_MAX_ATTEMPTS=30
DB_INIT_RETRY_SECONDS=2
DB_CONNECT_TIMEOUT_SECONDS=5


# ------------------------------------------------------------
# 회원가입 약관 초기 데이터
# 담당자가 migration profile을 명시적으로 실행할 때 약관을 생성하는 데 사용합니다.
# ------------------------------------------------------------

# 개발용 약관 버전. 운영 약관 버전과 구분하기 위해 dev- 접두사를 사용합니다.
SIGNUP_TERMS_VERSION=dev-20260823

# 해당 약관 버전이 적용되는 시각. ISO-8601 형식으로 입력합니다.
SIGNUP_TERMS_EFFECTIVE_AT=2026-08-23T00:00:00+09:00

# 약관 본문의 외부 URL 기준 주소입니다. 비워두면 프로젝트 기본 약관 내용을 사용합니다.
SIGNUP_TERMS_CONTENT_BASE_URL=

# 가상투자 시작 단계에서 사용하는 상품설명서와 투자 필수 약관입니다.
INVESTMENT_TERMS_VERSION=dev-20260824
INVESTMENT_TERMS_EFFECTIVE_AT=2026-08-24T00:00:00+09:00
INVESTMENT_TERMS_CONTENT_BASE_URL=


# ------------------------------------------------------------
# Redis
# 로그인/시세/뉴스 캐시 등 Backend와 AI가 사용하는 Redis 주소입니다.
# ------------------------------------------------------------

# Docker 내부 Redis 접속 주소
REDIS_URL=redis://redis:6379/0


# ------------------------------------------------------------
# Backend 인증 및 접근 정책
# 로그인 토큰과 접근 허용 Origin을 설정합니다.
# ------------------------------------------------------------

# JWT 로그인 토큰 서명에 사용하는 비밀 문자열
# 로컬에서도 임의의 긴 문자열로 변경해서 사용합니다.
JWT_SECRET=replace-with-a-long-random-secret

# 로그인 Access Token 유효시간(분)
ACCESS_TOKEN_MINUTES=60

# Azure Communication Services Email 연결 문자열과 발신 주소
# 발신 주소는 연결된 Email Communication Services 도메인의 MailFrom 주소를 사용합니다.
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER_ADDRESS=

# 이메일 OTP HMAC 서명용 비밀값. 운영 환경에서는 충분히 긴 무작위 문자열을 사용합니다.
EMAIL_OTP_SECRET=replace-with-a-long-random-secret

# OTP 유효시간, 최대 검증 횟수, 재발송 대기시간, 이메일/IP별 시간당 발송 한도
EMAIL_OTP_TTL_SECONDS=300
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_HOURLY_LIMIT=5
EMAIL_OTP_IP_HOURLY_LIMIT=20

# OTP 검증 후 발급되어 회원가입에 한 번만 사용할 수 있는 증명의 유효시간
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=1800

# Frontend에서 Backend API 호출을 허용할 Origin
CORS_ORIGINS=http://localhost:5173


# ------------------------------------------------------------
# Azure OpenAI 투자성향 분석
# Backend가 설문 답변을 전달하고 같은 HTTP 요청에서 분석 결과를 반환합니다.
# Endpoint 예시: https://<RESOURCE_NAME>.openai.azure.com
# ------------------------------------------------------------

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AI_PROFILE_TIMEOUT_SECONDS=15
AI_PROFILE_MODEL_VERSION=investor-profile-v1
AI_PROFILE_PROMPT_VERSION=v1

# 저장된 투자성향으로 전략 순위를 생성하는 학습 완료 모델 deployment
AZURE_OPENAI_RECOMMENDATION_DEPLOYMENT=
AI_RECOMMENDATION_TIMEOUT_SECONDS=15
AI_RECOMMENDATION_MODEL_VERSION=strategy-recommender-v1
AI_RECOMMENDATION_PROMPT_VERSION=v1
AI_RECOMMENDATION_DATASET_VERSION=financial-8y-v1
STRATEGY_CATALOG_VERSION=v1

# 포트폴리오의 검증된 조정 후보에 이유와 why-now를 생성하는 모델 deployment
AZURE_OPENAI_REBALANCING_DEPLOYMENT=
AI_REBALANCING_TIMEOUT_SECONDS=15
AI_REBALANCING_MODEL_VERSION=rebalancing-v1


# ------------------------------------------------------------
# 한국투자증권 KIS Open API
# 실시간/현재 주가 조회에 사용합니다.
# 한국투자증권 Open API에서 발급받은 App Key와 App Secret을 입력합니다.
# 실제 주문은 KIS 주문 API가 아니라 프로젝트 내부 가상계좌에서 처리합니다.
# ------------------------------------------------------------

# 한국투자증권 Open API App Key
KIS_APP_KEY=

# 한국투자증권 Open API App Secret
KIS_APP_SECRET=

# 한국투자증권 Open API 기본 주소
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# KIS 국내주식 실시간 체결가 WebSocket 주소
KIS_WEBSOCKET_URL=ws://ops.koreainvestment.com:21000

# KIS API 요청 제한시간(초)
KIS_TIMEOUT_SECONDS=3

# KIS 분봉 pagination 및 rate-limit retry 사이 최소 대기시간(초)
KIS_REST_PAGE_INTERVAL_SECONDS=0.5

# KIS에서 조회한 현재가를 Redis에 보관하는 시간(초)
PRICE_CACHE_TTL_SECONDS=5
MINUTE_CANDLE_CACHE_TTL_SECONDS=15

# WebSocket에서 수신한 최신 체결가의 Redis 보관 시간(초)
REALTIME_PRICE_CACHE_TTL_SECONDS=30

# 가상 체결과 평가에 사용할 수 있는 실시간 가격의 최대 수신 지연(초)
REALTIME_PRICE_STALE_SECONDS=10

# KIS WebSocket 재연결 지수 backoff 최대 대기시간(초)
KIS_REALTIME_RECONNECT_MAX_SECONDS=30

# 실시간 API client별 대기 queue 크기
KIS_REALTIME_CLIENT_QUEUE_SIZE=100

# 실시간 API client 하나가 동시에 구독할 수 있는 최대 종목 수
KIS_REALTIME_MAX_SYMBOLS_PER_CLIENT=20


# ------------------------------------------------------------
# NAVER Cloud Platform NAVER API HUB - 뉴스 검색 API
# Information 화면의 실제 한국 금융 뉴스 조회에 사용합니다.
# NCP 콘솔에서 NAVER API HUB Search API 이용 신청 후 발급받은 값을 입력합니다.
# ------------------------------------------------------------

# NAVER API HUB Client ID
NAVER_API_HUB_CLIENT_ID=

# NAVER API HUB Client Secret
NAVER_API_HUB_CLIENT_SECRET=

# NAVER API HUB 기본 주소
NAVER_NEWS_BASE_URL=https://naverapihub.apigw.ntruss.com

# 금융 뉴스 검색에 사용할 기본 검색어
NEWS_SEARCH_QUERY=증시

# 동일 뉴스 요청을 Redis에 캐시하는 시간(초)
NEWS_CACHE_TTL_SECONDS=300

# NAVER 뉴스 API 요청 제한시간(초)
NEWS_REQUEST_TIMEOUT_SECONDS=5


# ------------------------------------------------------------
# 공공데이터포털 금융 데이터 API
# data/ 수집 파이프라인에서 금융위원회 API 데이터를 가져올 때 사용합니다.
# data.go.kr에서 해당 API 활용 신청 후 발급받은 일반 인증키를 입력합니다.
# ------------------------------------------------------------

# 공공데이터포털 일반 인증키(ServiceKey)
DATA_GO_KR_API_KEY=


# ------------------------------------------------------------
# 한국거래소 KRX OPEN API
# data 수집 파이프라인에서 일별 가격·시가총액·종목 Master·시장 지수를 가져옵니다.
# 승인된 인증키는 data 컨테이너에서만 사용하며 Frontend에 전달하지 않습니다.
# ------------------------------------------------------------

# KRX OPEN API 인증키(Request header의 AUTH_KEY)
KRX_AUTH_KEY=

# KRX OPEN API 기본 주소와 단일 요청 제한시간(초)
KRX_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
KRX_TIMEOUT_SECONDS=10

# KRX 날짜 단위 병렬 요청 수. API 제한을 고려한 안전한 기본값이며 최대 16으로 제한됩니다.
KRX_MAX_CONCURRENCY=4

# 8년 Feature 생성 시 한 번에 메모리에 올릴 종목 수. 10~500 범위로 제한됩니다.
KRX_FEATURE_STOCK_BATCH_SIZE=100


# ------------------------------------------------------------
# 금융감독원 OpenDART API
# data 수집 파이프라인에서 기업·재무·공시 데이터를 가져올 때 사용합니다.
# OpenDART에서 발급받은 인증키를 입력하고 실제 값은 커밋하지 않습니다.
# ------------------------------------------------------------

# 금융감독원 OpenDART API 인증키 (data 수집 컨테이너에서만 사용)
OPENDART_API_KEY=your_opendart_api_key

# OpenDART 단일 HTTP 요청 제한시간(초)
OPENDART_TIMEOUT_SECONDS=10

# OpenDART는 일일 호출 제한이 엄격하므로 기본 1개 worker로 직렬 처리합니다.
OPENDART_MAX_CONCURRENCY=1

# OpenDART 요청 사이 최소 간격(초). concurrency를 올릴 때도 제한을 제거하지 않습니다.
OPENDART_MIN_INTERVAL_SECONDS=0.25


# ------------------------------------------------------------
# 한국은행 ECOS Open API
# data 수집 파이프라인에서 기준금리·환율·CPI·국고채 금리를 가져올 때 사용합니다.
# 한국은행 ECOS에서 발급받은 인증키를 입력하고 실제 값은 커밋하지 않습니다.
# ------------------------------------------------------------

# 한국은행 ECOS API 인증키 (data 수집 컨테이너에서만 사용)
ECOS_API_KEY=your_ecos_api_key

# ECOS 단일 HTTP 요청 제한시간(초)
ECOS_TIMEOUT_SECONDS=10

# ECOS 시계열×월 단위 병렬 요청 수. 과도한 일일 호출을 막기 위해 최대 4로 제한됩니다.
ECOS_MAX_CONCURRENCY=2


# ------------------------------------------------------------
# Azure Blob Storage
# 금융 Raw / Processed / Features 데이터를 저장하고 읽을 때 사용합니다.
# 실제 Azure 인증은 Connection String이 아니라 Azure CLI/Entra ID의
# DefaultAzureCredential을 사용합니다.
# ------------------------------------------------------------

# Azure Portal의 Storage Account 이름
# 예: sesacfinance001
AZURE_STORAGE_ACCOUNT_NAME=

# 로컬 Azurite에서만 사용하는 연결 문자열입니다.
# 실제 Azure에서는 설정하지 않고 AZURE_STORAGE_ACCOUNT_NAME과 Entra ID를 사용합니다.
AZURE_STORAGE_CONNECTION_STRING=

# API에서 수집한 원본 데이터를 저장하는 Blob Container 이름
AZURE_STORAGE_CONTAINER_RAW=raw

# 정제한 Parquet 데이터를 저장하는 Blob Container 이름
AZURE_STORAGE_CONTAINER_PROCESSED=processed

# 모델 학습/추론용 Feature 데이터를 저장하는 Blob Container 이름
AZURE_STORAGE_CONTAINER_FEATURES=features

# Azure SDK가 Blob 한 개를 업로드할 때 사용하는 최대 병렬 전송 수입니다.
BLOB_UPLOAD_MAX_CONCURRENCY=4

# 성공 partition을 원격 coverage manifest에 저장하는 주기입니다.
MODEL_RAW_CHECKPOINT_EVERY=5
