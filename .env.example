# Application ports (change only when a host port is already in use)
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local development database. Rotate these sample credentials for shared environments.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Compose containers use the postgres service hostname.
DATABASE_URL=postgresql://app:app@postgres:5432/app

# Docker Compose 전용 개발 약관 seed. 운영 약관 version과 혼용하지 않습니다.
SIGNUP_TERMS_VERSION=dev-20260823
SIGNUP_TERMS_EFFECTIVE_AT=2026-08-23T00:00:00+09:00
SIGNUP_TERMS_CONTENT_BASE_URL=

# Optional: use this URL when running Data scripts directly on the host.
# HOST_DATABASE_URL=postgresql://app:app@localhost:5432/app

# Local development cache
REDIS_URL=redis://redis:6379/0

# Backend auth and virtual-account policy (production JWT_SECRET must be a long random secret)
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
VIRTUAL_ACCOUNT_INITIAL_CASH=10000000
CORS_ORIGINS=http://localhost:5173

# Optional external service secrets (never commit real values)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_TIMEOUT_SECONDS=3
PRICE_CACHE_TTL_SECONDS=5
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
NAVER_NEWS_BASE_URL=https://naverapihub.apigw.ntruss.com
NEWS_SEARCH_QUERY=증시
NEWS_CACHE_TTL_SECONDS=300
NEWS_REQUEST_TIMEOUT_SECONDS=5
DATA_GO_KR_API_KEY=
OPENDART_API_KEY=
ECOS_API_KEY=

# Azure Blob data lake (DefaultAzureCredential / Managed Identity / Azure CLI)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_RAW=raw
AZURE_STORAGE_CONTAINER_PROCESSED=processed
AZURE_STORAGE_CONTAINER_FEATURES=features
# Local Azurite only; never commit a production connection string.
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
