# Application ports (change only when a host port is already in use)
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local development database
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql://app:app@postgres:5432/app

# Local development cache
REDIS_URL=redis://redis:6379/0

# Optional external service secrets (never commit real values)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
