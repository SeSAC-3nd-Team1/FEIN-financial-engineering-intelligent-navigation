# Application ports (change only when a host port is already in use)
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local development database. Rotate these sample credentials for shared environments.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Compose containers use the postgres service hostname.
DATABASE_URL=postgresql://app:app@postgres:5432/app

# Optional: use this URL when running Data scripts directly on the host.
# HOST_DATABASE_URL=postgresql://app:app@localhost:5432/app

# Local development cache
REDIS_URL=redis://redis:6379/0

# Optional external service secrets (never commit real values)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Korea Investment & Securities Open API
# Use paper-trading credentials for the PoC. Never commit real values.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_MODE=paper
KIS_USE_MOCK_FALLBACK=true
# Real-account orders stay blocked unless this is explicitly true.
KIS_ENABLE_LIVE_TRADING=false

DATA_GO_KR_API_KEY=
OPENDART_API_KEY=
ECOS_API_KEY=

# Azure Blob data lake (DefaultAzureCredential / Managed Identity / Azure CLI)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_RAW=raw
AZURE_STORAGE_CONTAINER_PROCESSED=processed
AZURE_STORAGE_CONTAINER_FEATURES=features
# Local Azurite only; never commit a production connection string.
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
