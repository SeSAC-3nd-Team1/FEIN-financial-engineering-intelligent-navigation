FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-db-init.txt ./
RUN pip install --no-cache-dir -r requirements-db-init.txt

COPY alembic.ini ./
COPY db ./db
COPY scripts ./scripts

CMD ["python", "-m", "scripts.init_local_db"]
